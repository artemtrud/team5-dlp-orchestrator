{
  "openapi": "3.0.1",
  "info": {
    "title": "BackendOrchestrator",
    "version": "1.0"
  },
  "paths": {
    "/api/proxy-events": {
      "post": {
        "tags": [
          "BackendOrchestrator"
        ],
        "summary": "Приём события от Reverse Proxy (шаг 5 на схеме)",
        "operationId": "ReceiveProxyEvent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProxyEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/dns-events": {
      "post": {
        "tags": [
          "BackendOrchestrator"
        ],
        "summary": "Тестовый приём события dns_hit (имитация шины Redis)",
        "operationId": "ReceiveDnsEvent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DnsHitEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/incidents": {
      "get": {
        "tags": [
          "BackendOrchestrator"
        ],
        "summary": "Получить список всех инцидентов (для Frontend UI)",
        "operationId": "GetIncidents",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DnsHitEvent": {
        "type": "object",
        "properties": {
          "ip": {
            "type": "string",
            "nullable": true
          },
          "domain": {
            "type": "string",
            "nullable": true
          },
          "timestamp": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      },
      "ProxyEvent": {
        "type": "object",
        "properties": {
          "ip": {
            "type": "string",
            "nullable": true
          },
          "domain": {
            "type": "string",
            "nullable": true
          },
          "verdict": {
            "type": "string",
            "nullable": true
          },
          "maskedText": {
            "type": "string",
            "nullable": true
          },
          "timestamp": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      }
    }
  }
}